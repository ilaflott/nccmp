netcdf test4a {

dimensions:
    dim1 = 1, dim2 = 2, dim3 = 2, dim4 = 2, rec = unlimited ; 
        
variables:
    double data1(dim1, dim2);       // test values
    float data2(dim1, dim3);         
    long  data3(dim2);               
    int data4(dim4);                
    short recdata1(rec, dim2);       
    char recdata2(rec, dim3);       
    float rec(rec);                  

data:
   data1   = 1, 2 ;
   data2   = 7, 8 ;
   data3   = 9, 10;
   data4   = 11, 12;
   recdata1 = 3, 4 ;
   recdata2 = 'a', 'b' ;
   rec     = 5, 6 ;
}
