I686=/net2/rsz/i686/netcdf-4.0/gcc-4.1.2/
I686=/usr/local/netcdf-4.1.1/
I686INC=-I$(I686)/include -I$(I686) -I$(I686)/libsrc4 -I$(I686)/libsrc
I686LIB=-L/usr/local/lib -lnetcdf -lhdf5_hl -lhdf5 -lz -lm

IA64=/net2/rsz/ia64/netcdf-4.0.1/
IA64INC=-I$(IA64)/include -I$(IA64)/src/libsrc -I$(IA64)/src/libsrc4 -I$(IA64)/src -I/usr/local/hdf5-1.8.1/include/
IA64LIB=-L$(IA64)/lib/shared -lnetcdf -L/usr/local/hdf5-1.8.1/lib -lhdf5_hl -lhdf5 -lz -L/opt/mpt/mpt-1.22/lib/ -lmpi

all: ia64

i686:
	gcc -static $(I686INC) -O3 ncinfo.c $(I686LIB) -o ncinfo

ia64:
	icc $(IA64INC) -O3 ncinfo.c $(IA64LIB) -o ncinfo

gcc:
	gcc -static -O3 -Iinclude ncinfo.c -L/usr/local/lib -lnetcdf -lhdf5_hl -lhdf5 -lz -lm -o ncinfo
	
clean:
	rm -f ncinfo tmp.stdout

distclean:
	rm -f ncinfo tmp.stdout test1.nc test2.nc ncinfo.ia64

check: test
	

test:
	./test.sh
    
dist:
	cd ../; tar zcvf ncinfo.tgz src
